[
  [
    {
      "audioId": "new_present_perfect_0093",
      "ttsText": "The group has built a wooden bench beside the path.",
      "sourceFilePath": "audio/present-perfect/new_present_perfect_0093.mp3",
      "targetHtmlFile": "present-perfect.html",
      "audioElementId": "audio_new_present_perfect_0093",
      "audioSelector": "#audio_new_present_perfect_0093",
      "targetAttribute": "src",
      "embedAs": "data:audio/mpeg;base64,<BASE64_MP3_BYTES>",
      "kind": "story_sentence",
      "lesson": "present-perfect"
    },
    {
      "audioId": "new_present_perfect_0095",
      "ttsText": "Sara has just painted it green.",
      "sourceFilePath": "audio/present-perfect/new_present_perfect_0095.mp3",
      "targetHtmlFile": "present-perfect.html",
      "audioElementId": "audio_new_present_perfect_0095",
      "audioSelector": "#audio_new_present_perfect_0095",
      "targetAttribute": "src",
      "embedAs": "data:audio/mpeg;base64,<BASE64_MP3_BYTES>",
      "kind": "story_sentence",
      "lesson": "present-perfect"
    },
    {
      "audioId": "new_present_perfect_0097",
      "ttsText": "Sara has been to the tool shed and has returned with a pair of gloves.",
      "sourceFilePath": "audio/present-perfect/new_present_perfect_0097.mp3",
      "targetHtmlFile": "present-perfect.html",
      "audioElementId": "audio_new_present_perfect_0097",
      "audioSelector": "#audio_new_present_perfect_0097",
      "targetAttribute": "src",
      "embedAs": "data:audio/mpeg;base64,<BASE64_MP3_BYTES>",
      "kind": "story_sentence",
      "lesson": "present-perfect"
    },
    {
      "audioId": "new_present_perfect_0098",
      "ttsText": "Noah has gone to the other side of the garden to find a rake; he is not back yet.",
      "sourceFilePath": "audio/present-perfect/new_present_perfect_0098.mp3",
      "targetHtmlFile": "present-perfect.html",
      "audioElementId": "audio_new_present_perfect_0098",
      "audioSelector": "#audio_new_present_perfect_0098",
      "targetAttribute": "src",
      "embedAs": "data:audio/mpeg;base64,<BASE64_MP3_BYTES>",
      "kind": "story_sentence",
      "lesson": "present-perfect"
    },
    {
      "audioId": "new_present_perfect_0100",
      "ttsText": "They have shared snacks and have told stories while they plant.",
      "sourceFilePath": "audio/present-perfect/new_present_perfect_0100.mp3",
      "targetHtmlFile": "present-perfect.html",
      "audioElementId": "audio_new_present_perfect_0100",
      "audioSelector": "#audio_new_present_perfect_0100",
      "targetAttribute": "src",
      "embedAs": "data:audio/mpeg;base64,<BASE64_MP3_BYTES>",
      "kind": "story_sentence",
      "lesson": "present-perfect"
    },
    {
      "audioId": "new_present_perfect_0101",
      "ttsText": "The garden has changed the empty lot.",
      "sourceFilePath": "audio/present-perfect/new_present_perfect_0101.mp3",
      "targetHtmlFile": "present-perfect.html",
      "audioElementId": "audio_new_present_perfect_0101",
      "audioSelector": "#audio_new_present_perfect_0101",
      "targetAttribute": "src",
      "embedAs": "data:audio/mpeg;base64,<BASE64_MP3_BYTES>",
      "kind": "story_sentence",
      "lesson": "present-perfect"
    }
  ],
  [
    {
      "audioId": "new_present_perfect_0104",
