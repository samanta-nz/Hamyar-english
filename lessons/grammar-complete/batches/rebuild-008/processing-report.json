{
  "batch": "rebuild-008",
  "accepted": [
    {
      "id": "new_present_continuous_0077",
      "text": "He works in a bank.",
      "recording": "b19a52403fe38f95f6d871992d68a59858b18e6f5025bed9affbcdd2e7d89762"
    },
    {
      "id": "new_present_continuous_0078",
      "text": "He is working from home this week.",
      "recording": "6fc8b28ab71fe0dad99b10fbabc5f7b67a911a967fa7c9547aecd12d1715aebe"
    },
    {
      "id": "new_present_continuous_0086",
      "text": "She is working in the art room with her friend Noah.",
      "recording": "1e2b5f8c839510d7707c80a4242385f63d00723c5072ba6a27397e7f573e49f2"
    },
    {
      "id": "new_present_continuous_0089",
      "text": "Their teacher is carrying clean paper from one table to another.",
      "recording": "b7b24ca562cf73bb57763206e2a2570fdcf0bf97ec46ad711a254aeaf8d0f0cd"
    },
    {
      "id": "new_present_continuous_0093",
      "text": "She knows that good art takes patience.",
      "recording": "5a1b00cae317db531b97c144e6c303855eac91ff54a649da07fded96272a92f6"
    },
    {
      "id": "new_present_continuous_0094",
      "text": "Look!",
      "recording": "2b2e6386fdfb83273eea1b2d4b3294eac61e9967d949d9f5ecedbd25c3cf2234"
    },
    {
      "id": "new_present_continuous_0095",
      "text": "A small drop of blue paint is falling onto the table.",
      "recording": "6313f054a31202049cf777f5c0f7461e566bf58ba2c2d9e96513f7ede706dd8e"
    },
    {
      "id": "new_present_continuous_0097",
      "text": "They are cleaning the table together.",
      "recording": "1ad34f1c8b5861231d4b44bc604737e3b71860c1ff640bcec7ed22b496866f25"
    },
    {
      "id": "new_present_continuous_0098",
      "text": "The teacher is not getting angry because accidents happen during creative work.",
      "recording": "169fe72cdca67f3812e54c237ac5aacb1f20de5b8c1527549ff2b7b5872a0d9f"
    },
    {
      "id": "new_present_continuous_0101",
      "text": "Sara is meeting her parents at the gallery at six.",
      "recording": "8f7e08c28e655d047a3e42bb03fe4ab2ba82a7fc00e3f30291a1c95ae9bdd1a4"
    },
    {
      "id": "new_present_continuous_0104",
      "text": "Listen!",
      "recording": "2291c6d738b710ed3125abd65f7fc296459d3c5f5ec97de7ddf936e2b4072c77"
    },
    {
      "id": "new_present_continuous_0105",
      "text": "The students are talking about their pictures.",
      "recording": "fdcc20f9be13b86b1fd314f6c70217e848f9e85a3b0f927e8755c2ff0bad132a"
    },
    {
      "id": "new_present_continuous_0132",
      "text": "Choose the usual state verb form.",
      "recording": "3b78ed31b45d98901aac83396137c59e524cd17c537e8be21bad9be450e963a3"
    },
    {
      "id": "new_present_continuous_0134",
      "text": "Which sentence contrasts with a habit?",
      "recording": "958415e44f13939b727c579874794f925b2107e44afa02065f0dbb05306e0987"
    },
    {
      "id": "new_present_continuous_0136",
      "text": "Choose the correct negative.",
      "recording": "7b833aed26f162df10cb3f57bda1fc39212ab10f36d3f2db549f416923f377a0"
    },
    {
      "id": "present_perfect_listen_01",
      "text": "I have just finished my work.",
      "recording": "5991add9b515548be508cde5642e211ffedb1452edf1b0a8c3916c43fecd1b5e"
    },
    {
      "id": "present_perfect_listen_02",
      "text": "Have you ever visited Rome?",
