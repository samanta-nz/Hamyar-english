    {
      "id": "verb_example_049",
      "text": "Mr Lee teaches science.",
      "recording": "acce2b9c6e429a00daeb28d2e08721632c150a97ff7259ce8daf02c6fdeae72f"
    },
    {
      "id": "verb_example_050",
      "text": "I tell my sister a story.",
      "recording": "3622e31a08c2a37f19c21bede10a8e6737d9e2fcb80bba7063a4a36f26838c68"
    },
    {
      "id": "verb_example_051",
      "text": "We think about the question.",
      "recording": "1a3c81f6e075afddce2254391461c040374c9898e81064a769de0ca98e7331a7"
    },
    {
      "id": "verb_example_052",
      "text": "He understands the lesson.",
      "recording": "3db19a530bf07e156b059244c22f018b1f3599bb8cf5c9121e5c74e85f2d9c31"
    },
    {
      "id": "verb_example_053",
      "text": "She wears a warm coat.",
