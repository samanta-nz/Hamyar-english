  "accepted": [
    {
      "id": "new_to_be_0085",
      "text": "Sara is a new student at Green Hill School.",
      "recording": "f5aa67c91a302b248db25a311adbd68e6ab18576a156d3c21cd16a1875dfcd7f"
    },
    {
      "id": "new_to_be_0088",
      "text": "A quiet clock is above the door.",
      "recording": "e173d8da3fb2d6addc908e85be8b4962b0714207b3ce44ded80febb6c82a625d"
    },
    {
      "id": "new_to_be_0091",
      "text": "Mr.",
      "recording": "1a24b7688c199c24d87b5984d152b37d1d528911ec852d9cdf98c3ef29b916ea"
    },
    {
      "id": "new_to_be_0092",
      "text": "Lee is her science teacher.",
      "recording": "f5c0f2fbb9b439840433c62325a6a1ad3b47c2bbcfd8b1ad79443fddd9bebc7f"
    },
    {
      "id": "new_to_be_0093",
      "text": "He is kind and patient.",
      "recording": "09858981d245e2d854563342b0ac9b6ae90b2d60be4f6ec60b8546486b701ae6"
    },
    {
      "id": "new_to_be_0096",
      "text": "“You are in the right room.",
      "recording": "b0e242ce04fba040f0892135d5afe9a0e4b7c432f90b6ea753a6d273e76a4ec3"
    },
    {
      "id": "present_simple_sentence_006",
      "text": "She has a car.",
      "recording": "d360896124b044e25d81afe402b3ccccfeff053587fcbf5f6a0d3b5af56293d0"
    },
    {
      "id": "present_simple_sentence_007",
      "text": "Do you work here?",
      "recording": "d3b205318cdb4049486b7392aae3dca9d33fc294794976aa6a8dfb959404cac0"
    },
    {
      "id": "present_simple_sentence_008",
      "text": "Do they play chess?",
      "recording": "c81fa6c724efc4ca301238db06d5725c39008dbb0c46a21fc8783805bf08a710"
    },
    {
      "id": "present_simple_sentence_010",
      "text": "Does Sara study English?",
      "recording": "22b036c9d160df16eccbf70d24f7bcfdf5607a0acf833cceb3532f02470b2841"
    },
    {
      "id": "present_simple_sentence_011",
      "text": "They don't play chess.",
      "recording": "aeffd9bf8290eb85f8a81d1c1ab87270477ae805c26a17a08a8d797a643eb751"
    },
    {
      "id": "present_simple_sentence_012",
      "text": "We don't need help.",
